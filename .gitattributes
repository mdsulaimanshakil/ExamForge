# Normalize line endings: LF in the repository and working tree (Windows-safe).
* text=auto eol=lf

# Windows scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts / Maven wrapper must stay LF (CI runs on Linux)
*.sh   text eol=lf
mvnw   text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.jar  binary
*.woff binary
*.woff2 binary
*.xlsx binary

# Collapse lockfiles in diffs
frontend/package-lock.json linguist-generated=true -diff
